# SpamShield configuration. Every value is optional; the defaults are shown.
# Copy to .env and edit. `make run` and `docker run --env-file .env` read it.

# Path to the trained model. Its model card (<name>.card.json) must sit next to it.
SPAMSHIELD_MODEL_PATH=models/spamshield.joblib

# Spam probability (0.01-0.99) at or above which a message is labelled spam.
# Raise it to flag fewer normal messages by mistake; lower it to catch more spam.
SPAMSHIELD_THRESHOLD=0.5

# Most emails read from one uploaded mailbox.
SPAMSHIELD_MAX_MESSAGES=5000

# Characters of a single message the model reads; the rest is ignored.
SPAMSHIELD_MAX_CHARS=20000

# DEBUG, INFO, WARNING or ERROR.
SPAMSHIELD_LOG_LEVEL=INFO

# Largest upload the web app accepts, in megabytes (a Streamlit setting).
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=50
